# Writing model: chat-completions, responses or anthropic
CHAT_LLM_PROTOCOL=chat-completions
CHAT_LLM_BASE_URL=https://api.openai.com/v1
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
CHAT_LLM_MAX_TOKENS=12000
CHAT_LLM_REASONING_EFFORT=
CHAT_LLM_EXTRA_BODY=

# Optional visual asset selector. Connection/model fall back to CHAT when blank.
KAIBUN_BACKGROUND_LLM_PROTOCOL=
KAIBUN_BACKGROUND_LLM_BASE_URL=
KAIBUN_BACKGROUND_LLM_API_KEY=
KAIBUN_BACKGROUND_LLM_MODEL=
KAIBUN_BACKGROUND_LLM_MAX_TOKENS=
KAIBUN_BACKGROUND_LLM_REASONING_EFFORT=
# Total duration of a text selection request, including streamed keepalives.
KAIBUN_BACKGROUND_REQUEST_TIMEOUT_SECONDS=180
# Optional shared auxiliary-model quotas. Blank uses provider defaults.
KAIBUN_BACKGROUND_REQUESTS_PER_MINUTE=
KAIBUN_BACKGROUND_TOKENS_PER_MINUTE=
# Optional independent selector proxy: uncomment blank for direct access.
# When omitted, the selector uses the shared chat_llm proxy.
# KAIBUN_BACKGROUND_PROXY_URL=

# Optional TTS; character voice references are included in characters/characters.toml.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
KAIBUN_PRODUCER_VOICE_ID=
KAIBUN_NICHIKA_IDOL_VOICE_ID=b3757a5a71ba4078be1e25b446190975
KAIBUN_FUYUKO_IDOL_VOICE_ID=

# Paths resolve relative to the repository root, even when started elsewhere.
KAIBUN_DATA_PATH=data
KAIBUN_ASSET_ROOT=assets
KAIBUN_CHARACTERS_PATH=characters/characters.toml
KAIBUN_PORT=8011
KAIBUN_PROXY_URL=
KAIBUN_PROXY_SERVICES=chat_llm,tts
# Optional: override the bundled FFmpeg binary with an absolute path.
KAIBUN_FFMPEG=
